* text=auto eol=lf
# Captures are byte-exact; their original CRLF is not trailing whitespace.
tests/data/** -text whitespace=cr-at-eol
# Raw wire delimiters and log endings are part of the retained recording.
tests/data/**/frames*.txt -whitespace
tests/data/**/*.log -whitespace
# Resources may contain text (such as DMF skins), but retain their exact bytes.
tests/data/**/res/* binary
*.png -text
*.gif -text
*.jpg -text
*.dmi -text
*.ico -text
