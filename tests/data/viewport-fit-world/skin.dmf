window "mainwindow"
    elem "mainwindow"
        type = MAIN
        size = 640x440
        title = "Viewport fit fixture"
        is-default = true
        statusbar = false
    elem "split"
        type = CHILD
        pos = 0,0
        size = 640x440
        anchor1 = 0,0
        anchor2 = 100,100
        left = "mapwindow"
        right = "panel"
        is-vert = true
        splitter = 50
window "mapwindow"
    elem "mapwindow"
        type = MAIN
        size = 640x480
        is-pane = true
    elem "map"
        type = MAP
        pos = 0,0
        size = 640x480
        anchor1 = 0,0
        anchor2 = 100,100
        is-default = true
window "panel"
    elem "panel"
        type = MAIN
        size = 320x480
        is-pane = true
    elem "label"
        type = LABEL
        pos = 0,0
        size = 320x480
        anchor1 = 0,0
        anchor2 = 100,100
        text = "Reserved panel"
